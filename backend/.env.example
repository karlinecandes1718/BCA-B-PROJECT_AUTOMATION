PORT=5000
# Mode: gmail or brevo
EMAIL_SERVICE=gmail

# Gmail SMTP Settings
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Go to Google Account > Security > App Passwords.
# 3. Generate an app password and paste it into EMAIL_PASS below.
EMAIL_USER=your_gmail_username@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Brevo SMTP Settings (Fallback / Alternative)
# Step 1: Sign up FREE at https://app.brevo.com
# Step 2: Settings > SMTP & API > SMTP to copy Login and SMTP Key
BREVO_SMTP_USER=your-brevo-account@email.com
BREVO_SMTP_KEY=your-brevo-smtp-key-here
BREVO_SENDER_EMAIL=your-verified-sender@email.com
BREVO_SENDER_NAME="3BCA-B Activity Portal"
