{
  "compilerOptions": {
    /* ── Language & Target ───────────────────────────────────────────── */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    /* ── Output ──────────────────────────────────────────────────────── */
    "outDir": "./dist",
    "rootDir": "./",

    /* ── Type Safety ─────────────────────────────────────────────────── */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    /* ── Module Interop ──────────────────────────────────────────────── */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* ── Source Maps (useful for debugging) ──────────────────────────── */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* ── Skip type-checking on third-party .d.ts files ───────────────── */
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
