# ─── Backend Environment Variables ──────────────────────────────────────────
# Replace dummy values with real values before running.
# Get your Gemini key from: https://aistudio.google.com/apikeys
GEMINI_API_KEY=dummy_api_key_here

# Admin authentication — stored securely server-side, never sent to the browser
# Must be at least 6 characters. Change this before any deployment.
ADMIN_PASSWORD=changeme123

# Server settings
NODE_ENV=development
PORT=5000
