# ─────────────────────────────────────────────────────────────────────────────
# Monorepo .gitignore — covers both /frontend (Next.js) and /backend (Node.js)
# ─────────────────────────────────────────────────────────────────────────────

# ─── SECURITY: Environment Variables ─────────────────────────────────────────
# Block ALL .env files at every depth in the monorepo.
# .env.example IS allowed (no secrets, just template keys).
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test
**/.env.staging
# Allow the safe template file
!**/.env.example

# ─── Node.js / npm ───────────────────────────────────────────────────────────
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*
package-lock.json.bak

# ─── Next.js (Frontend) ──────────────────────────────────────────────────────
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Testing & Coverage ──────────────────────────────────────────────────────
/coverage/

# ─── OS & Editor Artifacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.pem

# ─── Deployment Platforms ────────────────────────────────────────────────────
.vercel
